{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "个人精灵",
  "version": "2.4.0",
  "identifier": "com.xiaokong.personal-sprite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "个人精灵 v2.4.0",
        "width": 860,
        "height": 680,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true
      },
      {
        "label": "overlay",
        "title": "精灵译窗",
        "url": "overlay.html",
        "width": 300,
        "height": 120,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "ocr-overlay",
        "title": "精灵OCR覆盖层",
        "url": "ocr-overlay.html",
        "width": 100,
        "height": 100,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "fullscreen": true
      },
      {
        "label": "region-picker",
        "title": "框选翻译区域",
        "url": "region-picker.html",
        "width": 100,
        "height": 100,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}